# Keep .env private. Setup guide: README.md; deployment: docs/DEPLOYMENT.md.
# First setup: enter only SUPABASE_ACCESS_TOKEN, RESEND_API_KEY and STRIPE_TEST_SECRET_KEY.
# Run npm run kickstart. Keep generated values for reruns. Guide: docs/KICKSTART.md.

# === APP ==============================================================
# You fill in
APP_NAME=Forma
# Active URL; APP_URL_DEV is a saved reference only.
APP_URL=http://localhost:3000
APP_URL_DEV=http://127.0.0.1:3000
# Enable indexing only when ready to launch; rebuild after changing.
SEO_INDEXABLE=false

# === SUPABASE | hosted database & authentication ======================
# You fill in - management token: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional settings - organization/US region overrides: docs/KICKSTART.md
# Rerun kickstart after changing email verification.
AUTH_EMAIL_VERIFICATION=false
# Optional: dedicated target for npm run test:hosted.
HOSTED_TEST_PROJECT_REF=

# Kickstart fills in - creates a US project; preserves it on reruns
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets; never expose in browser code.
SUPABASE_SECRET_KEY=
SUPABASE_EMAIL_HOOK_SECRET=

# === RESEND | email ==================================================
# You fill in - Full access API key: resend.com/api-keys
RESEND_API_KEY=

# Optional: inbox for the public contact form.
CONTACT_TO_EMAIL=

# Kickstart fills in - leave blank for automatic sender selection
# Verified domain when available; otherwise test email to your Resend inbox only.
# You can override the sender/mode; see docs/KICKSTART.md.
RESEND_FROM_EMAIL=
RESEND_TEST_MODE=
RESEND_TEMPLATE_WELCOME_ID=
RESEND_TEMPLATE_VERIFICATION_ID=
RESEND_TEMPLATE_PASSWORD_RESET_ID=
RESEND_TEMPLATE_MAGIC_LINK_ID=
RESEND_TEMPLATE_WORKSPACE_INVITATION_ID=

# === STRIPE | billing ================================================
# You fill in - Dashboard > Developers > API keys (Secret keys)
# Test is for local setup; live is required for billing deployment.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Kickstart fills in - test
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID_STARTER=
STRIPE_TEST_PRODUCT_ID_PRO=
STRIPE_TEST_PRODUCT_ID_GROWTH=

# Kickstart fills in - live, during deployment
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID_STARTER=
STRIPE_LIVE_PRODUCT_ID_PRO=
STRIPE_LIVE_PRODUCT_ID_GROWTH=

# === OPENROUTER | optional AI example =================================
# You fill in - server-only API key and model
AI_ENABLED=false
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4.1-mini

# === GITHUB | source repository ======================================
# You fill in - setup-only token; permissions in docs/DEPLOYMENT.md
GITHUB_TOKEN=

# Kickstart fills in - deployment (optional overrides: docs/DEPLOYMENT.md)
GITHUB_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_ID=
GITHUB_REPOSITORY=

# === VERCEL | hosting ================================================
# You fill in - setup-only token: vercel.com/account/tokens
VERCEL_TOKEN=

# Kickstart fills in - deployment (optional overrides: docs/DEPLOYMENT.md)
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=
VERCEL_PROJECT_ID=
# Production URL; can be supplied for a custom domain.
APP_URL_LIVE=
