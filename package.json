{
  "name": "forma-saas-template",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "admin:grant": "node scripts/admin/index.mjs grant",
    "admin:revoke": "node scripts/admin/index.mjs revoke",
    "kickstart:admin": "node scripts/kickstart/install-admin.mjs",
    "kickstart:admin:billing": "node scripts/kickstart/update-admin-billing.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "kickstart": "node scripts/kickstart/index.mjs",
    "kickstart:check": "node scripts/kickstart/index.mjs --check",
    "kickstart:deploy": "node scripts/kickstart/index.mjs --deploy",
    "test": "node --test --test-isolation=none tests/setup/*.test.mjs",
    "test:hosted": "node scripts/test-hosted.mjs",
    "test:ui": "playwright test",
    "postinstall": "fumadocs-mdx",
    "kickstart:ai": "node scripts/kickstart/install-ai.mjs",
    "kickstart:onboarding": "node scripts/kickstart/install-onboarding.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.102",
